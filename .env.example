# --- OpenAI (default) ---
OPENAI_API_KEY=replace_with_deepseek_key
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_CHAT_MODEL=deepseek-chat

# --- Alternative: Google Gemini (free tier, OpenAI-compatible) ---
# Get a free key at https://aistudio.google.com/apikey
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001   # supports dimensions=768/1536/3072
# OPENAI_CHAT_MODEL=gemini-2.5-flash
# EMBEDDING_DIM=768

# --- Alternative: Ollama (free, fully local) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_EMBEDDING_MODEL=nomic-embed-text
# OPENAI_CHAT_MODEL=llama3.2
# EMBEDDING_DIM=768

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://rag:replace_with_password@localhost:5432/rag

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
EMBEDDING_DIM=1024

# --- Retrieval pipeline ---
RETRIEVAL_CANDIDATES=10   # candidates per retriever before fusion/rerank
USE_HYBRID=true           # vector + keyword search (RRF)
USE_RERANK=true           # LLM re-ranking of fused candidates
MIN_RELEVANCE=0.12        # below this top cosine sim, decline instead of guessing

# --- Rate limiting (protects a public demo) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10  # per-IP requests/minute to /query and /documents

# PostgreSQL Docker Compose password
POSTGRES_PASSWORD=replace_with_password

OPENAI_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=replace_with_siliconflow_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
